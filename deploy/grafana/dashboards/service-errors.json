      },
      "description": "Error rate grouped by the bounded custom_error_code enum (internal/apierr). Use this to tell a spike in one business failure mode (e.g. AUTH_INVALID_CREDENTIALS) apart from a dependency outage (INTERNAL_DB_ERROR, INTERNAL_CACHE_ERROR).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (custom_error_code) (rate(tech_internal_api_http_requests_total{custom_error_code!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{custom_error_code}}",
          "refId": "A"
        }
      ],
      "title": "Error rate by custom_error_code",
      "type": "timeseries"
